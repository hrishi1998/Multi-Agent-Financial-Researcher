# Application Config
APP_ENV=development
DEBUG=True
PORT=8000

# LLM Providers
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Financial Data APIs
SEC_EDGAR_USER_AGENT=YourName_or_Company_admin@example.com
MARKET_DATA_API_KEY=your_market_api_key

# Storage & Infrastructure
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quant_research
REDIS_URL=redis://localhost:6379/0

# Observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=multi-agent-financial-analyst
