# Application Config
APP_ENV=development
DEBUG=True
PORT=8000

# LLM Providers
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Financial Data APIs
SEC_EDGAR_USER_AGENT=YourName_or_Company_admin@example.com
MARKET_DATA_API_KEY=your_market_api_key

# Storage & Infrastructure
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quant_research
USE_PGVECTOR=1
VECTOR_DIM=64
REDIS_URL=redis://localhost:6379/0
ENABLE_HITL=0
ENABLE_SEMANTIC_CACHE=0
LLM_PROVIDER=mock

# API Security
API_KEY=change-me-in-production

# Streamlit frontend
API_BASE_URL=http://localhost:8000

# Observability
ENABLE_TELEMETRY=0
OTEL_SERVICE_NAME=multi-agent-financial-researcher
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=multi-agent-financial-analyst
